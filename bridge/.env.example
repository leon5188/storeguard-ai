# Server Configuration
PORT=3000
NODE_ENV=development

# GoHighLevel (GHL) API
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_KEY=your_ghl_v2_location_or_agency_api_token
GHL_LOCATION_ID=your_ghl_location_id

# TTLock Cloud OpenAPI
TTLOCK_API_BASE=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=your_ttlock_client_id
TTLOCK_CLIENT_SECRET=your_ttlock_client_secret
TTLOCK_ACCESS_TOKEN=your_ttlock_admin_access_token

# Webhook Secret Authorization
# GHL 工作流调用 /api/access/* 时必须带 `Authorization: Bearer <此值>`
# 未设置时所有门禁端点一律 503（fail-closed）
BRIDGE_API_SECRET=your_super_secret_webhook_bearer_token

# 允许调用 /api/lead/upsert 的浏览器来源（逗号分隔），生产环境请勿留 *
ALLOWED_ORIGINS=https://rent.oakridgestorage.com,https://storeguard-ai.vercel.app
